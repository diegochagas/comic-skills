{
  "title": "MyComic",
  "display_name": "My Comic — full name",
  "issues": ["1"],
  "script_pattern": "MyComic{issue}.md",
  "page_header_regex": "^=== PAGE (\\d+)\\s*[—-]\\s*(.*?)\\s*===\\s*$",
  "aspect": "2:3",
  "language": "pt-BR",
  "lettering": "xcf",
  "lettering_font": "CCWildWords Regular",
  "generation": "page",
  "_panel_mode": "set generation to \"panels\" and fill these: description_sets.source = describe-pages set of the original manga; panel_style = base style for ONE panel",
  "description_sets": { "source": "" },
  "panel_style": "",
  "page_size": [1365, 2048],
  "page_margin": 60,
  "panel_gutter": 30,
  "panel_border": 5,
  "panel_resolution": "1k",
  "style_label": "",
  "page_kinds": { "1": "cover", "2": "editorial" },
  "style_refs": {
    "cover": [],
    "editorial": [],
    "default": []
  },
  "cbz": {
    "max_height": 2048,
    "folder": "MyComic{issue}",
    "page_name": "page{issue}{page:02d}.jpg",
    "out_name": "MyComic{issue}.cbz"
  }
}
